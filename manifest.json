{
  "manifest_version": 3,
  "name": "OpenDial – Serverless Speed Dial",
  "short_name": "OpenDial",
  "version": "1.0.0",
  "description": "Privacy-first, zero-backend browser speed dial and productivity cockpit with client-side E2EE.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "public/background.js"
  },
  "action": {
    "default_title": "OpenDial Dashboard",
    "default_icon": {
      "16": "public/icon.png",
      "48": "public/icon.png",
      "128": "public/icon.png"
    }
  },
  "icons": {
    "16": "public/icon.png",
    "48": "public/icon.png",
    "128": "public/icon.png"
  }
}
